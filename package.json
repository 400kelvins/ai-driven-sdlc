{
  "name": "ai-driven-sdlc-deck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --port 3030",
    "build": "slidev build --without-notes",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" \"packages/*/tests/*.test.mjs\"",
    "review:speak": "node scripts/speak.mjs",
    "check:notes": "node scripts/check-notes-leak.mjs",
    "verify": "npm run test:unit && npm test && npm run build && npm run check:notes",
    "ship": "npm run verify && npm run gate:check && npx vercel --prod --yes",
    "gate:record": "node scripts/gate-record.mjs",
    "gate:check": "node scripts/gate.mjs check --stage review",
    "qr": "node scripts/make-qr.mjs",
    "check:public": "node scripts/check-public.mjs main",
    "pr:review": "node scripts/pr-review.mjs",
    "shots": "node scripts/slide-shots.mjs",
    "protect:main": "gh api -X PUT repos/{owner}/{repo}/branches/main/protection --input .github/branch-protection.json",
    "test:deck": "node --test \"tests/unit/*.test.mjs\"",
    "verify:deck": "npm run test:deck && npm test && npm run build && npm run check:notes"
  },
  "dependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*"
  ]
}
